<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PropDeal</RootNamespace>
    <AssemblyName>PropDeal</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- MySQL / MariaDB (XAMPP, MySQL Workbench) -->
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.2" />
    <!-- SQL Server (LocalDB, Express, SSMS) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Data\seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
